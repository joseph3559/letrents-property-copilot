# LETRENTS Property Copilot — environment template
# Copy to .env and fill in values. Never commit .env.

# Meta AI (Meta Model API) — primary AI provider.
# Get a key at https://ai.developer.meta.com (API keys tab).
META_API_KEY=
# OpenAI-compatible base URL for the Meta Model API.
META_API_BASE_URL=https://api.meta.ai/v1
# Model id, e.g. muse-spark-1.3 (recommended), muse-spark-1.2, muse-spark-1.1
META_MODEL=muse-spark-1.3
# Request timeout in ms.
META_TIMEOUT_MS=30000
# Max agent tool-call iterations per message (safety bound).
AGENT_MAX_ITERATIONS=8

# Server
PORT=3100
NODE_ENV=development

# Demo persistence directory (JSON store for the public demo adapter).
DEMO_DATA_DIR=.data

# Demo auth (single demo organization; do NOT use in production).
DEMO_ORG_ID=org-sunrise-demo
DEMO_USER_ID=user-demo-manager
